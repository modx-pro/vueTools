{
  "version": 1,
  "package": {
    "name": "vuetools",
    "modxPackage": "VueTools",
    "npmName": "vuetools",
    "npmSource": "package.json",
    "modxSource": "_build/config.inc.php"
  },
  "canonicalDocs": [
    "docs/PUBLIC_API.md",
    "DEVELOPER_GUIDE.md"
  ],
  "importMap": {
    "source": "core/components/vuetools/src/VueCore.php",
    "publicSpecifiers": [
      "vue",
      "pinia",
      "primevue",
      "vuetools",
      "vuetools/theme",
      "@vuetools/useApi",
      "@vuetools/useLexicon",
      "@vuetools/useModx",
      "@vuetools/usePermission",
      "@vuetools/usePrimeVueLocale",
      "@vuetools/useTheme"
    ],
    "internalSpecifiers": [
      "@vuetools/"
    ]
  },
  "modules": {
    "vue": {
      "specifier": "vue",
      "source": "src/vendor/vue.js",
      "mode": "star-plus-default",
      "notes": "export * from Vue ESM browser prod + default export for Vue 2-style libs"
    },
    "pinia": {
      "specifier": "pinia",
      "source": "src/vendor/pinia.js",
      "mode": "exact-named",
      "namedExports": [
        "createPinia",
        "defineStore",
        "storeToRefs",
        "setActivePinia",
        "getActivePinia",
        "mapState",
        "mapGetters",
        "mapActions",
        "mapStores",
        "mapWritableState",
        "acceptHMRUpdate"
      ],
      "defaultExport": false
    },
    "primevue": {
      "specifier": "primevue",
      "aliases": ["vuetools", "vuetools/theme"],
      "source": "src/vendor/primevue.js",
      "mode": "exact-named",
      "namedExports": [
        "PrimeVue",
        "Aura",
        "Modx",
        "ModxManagerTheme",
        "ModxTheme",
        "definePreset",
        "ConfirmationService",
        "ToastService",
        "DialogService",
        "useConfirm",
        "useToast",
        "useDialog",
        "Card",
        "Panel",
        "Fieldset",
        "Divider",
        "Splitter",
        "SplitterPanel",
        "ScrollPanel",
        "Toolbar",
        "Tabs",
        "TabList",
        "Tab",
        "TabPanels",
        "TabPanel",
        "DataTable",
        "Column",
        "ColumnGroup",
        "Row",
        "Paginator",
        "Tree",
        "TreeTable",
        "DataView",
        "OrderList",
        "PickList",
        "Timeline",
        "InputText",
        "InputNumber",
        "InputMask",
        "InputOtp",
        "InputChips",
        "Textarea",
        "Password",
        "InputGroup",
        "InputGroupAddon",
        "IconField",
        "InputIcon",
        "FloatLabel",
        "IftaLabel",
        "Select",
        "MultiSelect",
        "AutoComplete",
        "CascadeSelect",
        "TreeSelect",
        "Listbox",
        "Checkbox",
        "RadioButton",
        "ToggleButton",
        "ToggleSwitch",
        "SelectButton",
        "DatePicker",
        "ColorPicker",
        "Slider",
        "Rating",
        "Knob",
        "FileUpload",
        "Button",
        "ButtonGroup",
        "SplitButton",
        "SpeedDial",
        "Dialog",
        "ConfirmDialog",
        "ConfirmPopup",
        "DynamicDialog",
        "Drawer",
        "Popover",
        "Tooltip",
        "OverlayBadge",
        "Menu",
        "Menubar",
        "ContextMenu",
        "TieredMenu",
        "MegaMenu",
        "Breadcrumb",
        "Steps",
        "Dock",
        "Toast",
        "Message",
        "InlineMessage",
        "Badge",
        "Tag",
        "Chip",
        "Avatar",
        "AvatarGroup",
        "Image",
        "Galleria",
        "Carousel",
        "ProgressBar",
        "ProgressSpinner",
        "Skeleton",
        "BlockUI",
        "Terminal",
        "MeterGroup",
        "ScrollTop",
        "Inplace",
        "DeferredContent",
        "FocusTrap",
        "AnimateOnScroll",
        "StyleClass",
        "Ripple"
      ],
      "defaultExport": false
    },
    "useApi": {
      "specifier": "@vuetools/useApi",
      "source": "src/composables/useApi.js",
      "mode": "exact-named",
      "namedExports": ["useApi"],
      "defaultExport": "useApi",
      "returnKeys": ["request", "get", "post", "put", "delete", "buildUrl"]
    },
    "useLexicon": {
      "specifier": "@vuetools/useLexicon",
      "source": "src/composables/useLexicon.js",
      "mode": "exact-named",
      "namedExports": ["useLexicon"],
      "defaultExport": "useLexicon",
      "returnKeys": ["_", "has", "getByPrefix", "load"]
    },
    "useModx": {
      "specifier": "@vuetools/useModx",
      "source": "src/composables/useModx.js",
      "mode": "exact-named",
      "namedExports": ["useModx"],
      "defaultExport": "useModx",
      "returnKeys": [
        "config",
        "user",
        "siteId",
        "hasPermission",
        "getManagerUrl",
        "getAssetsUrl",
        "getConnectorUrl",
        "getSetting",
        "getContextKey",
        "isManager",
        "fireEvent"
      ]
    },
    "usePermission": {
      "specifier": "@vuetools/usePermission",
      "source": "src/composables/usePermission.js",
      "mode": "exact-named",
      "namedExports": ["usePermission"],
      "defaultExport": "usePermission",
      "returnKeys": [
        "can",
        "canAny",
        "canAll",
        "getAll",
        "canCreateResource",
        "canEditResource",
        "canDeleteResource",
        "canPublishResource",
        "canUnpublishResource",
        "canViewUsers",
        "canEditUsers",
        "canDeleteUsers",
        "canViewElements",
        "canEditElements",
        "canDeleteElements",
        "canViewSystemSettings",
        "canFlushSessions",
        "canClearCache",
        "canViewFiles",
        "canUploadFiles",
        "canDeleteFiles",
        "canInstallPackages"
      ]
    },
    "usePrimeVueLocale": {
      "specifier": "@vuetools/usePrimeVueLocale",
      "source": "src/composables/usePrimeVueLocale.js",
      "mode": "exact-named",
      "namedExports": ["getPrimeVueLocale", "usePrimeVueLocale"],
      "defaultExport": "usePrimeVueLocale",
      "returnKeys": ["locale", "getPrimeVueLocale"]
    },
    "useTheme": {
      "specifier": "@vuetools/useTheme",
      "source": "src/composables/useTheme.js",
      "mode": "exact-named",
      "namedExports": ["getActiveTheme", "getThemeName", "useTheme"],
      "defaultExport": "getActiveTheme",
      "returnKeys": ["theme"]
    }
  },
  "php": {
    "serviceKeys": {
      "canonical": "vuetools",
      "aliases": ["vueTools"]
    },
    "serviceClass": "VueTools\\Service",
    "bootstrap": "core/components/vuetools/bootstrap.php",
    "coreClass": "VueTools\\VueCore",
    "coreSource": "core/components/vuetools/src/VueCore.php",
    "publicMethods": [
      "include",
      "registerImportMap",
      "includeStyles",
      "includeManagerCombos",
      "isRegistered",
      "isStylesIncluded",
      "getVersions",
      "getVersion",
      "getAssetsUrl"
    ],
    "publicConstants": ["VERSION"]
  },
  "browser": {
    "global": "VueTools",
    "keys": ["theme"],
    "source": "core/components/vuetools/src/VueCore.php"
  },
  "settings": {
    "vuetools.theme": {
      "default": "aura",
      "values": ["aura", "modx"],
      "source": "_build/elements/settings.php",
      "valuesSource": "assets/components/vuetools/js/mgr/combo.theme.js"
    }
  },
  "css": {
    "isolationClass": "vueApp",
    "isolationSource": "vite.config.vendor.js",
    "darkClass": "p-dark",
    "darkSource": "src/theme/modx/index.js"
  },
  "internal": {
    "paths": [
      "src/composables/index.js",
      "src/theme/modx/primitive.js",
      "src/theme/modx/semantic.js",
      "src/theme/modx/dark.js",
      "src/theme/modx/components.js",
      "src/theme/modx/components/",
      "src/demo/",
      "vite.config.vendor.js",
      "vite.config.composables.js",
      "vite.config.demo.js"
    ],
    "notes": [
      "Import Map prefix @vuetools/ is registered but not a supported public API",
      "composables/index.min.js has no dedicated Import Map specifier",
      "Theme token modules are internal except named re-exports in primevue barrel"
    ]
  }
}
